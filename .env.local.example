# Скопируй этот файл в .env.local и заполни значения

# ID таблицы Google Sheets (из URL: .../spreadsheets/d/ВОТ_ЭТО/edit)
GOOGLE_SPREADSHEET_ID=

# Содержимое JSON-ключа сервисного аккаунта — ОДНОЙ строкой, без переносов!
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"fincab-reader@...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# Пароль входа в приложение (браузер/iOS PWA)
BASIC_AUTH_PASSWORD=

# Секрет для Vercel Cron Jobs (должен совпадать с заголовком Authorization: Bearer ... в cron-маршрутах)
CRON_SECRET=

# API-ключ для iOS Shortcuts и внешних клиентов (передаётся в заголовке X-API-Key)
# Сгенерируй любой длинный случайный ключ: openssl rand -hex 32
API_KEY=
